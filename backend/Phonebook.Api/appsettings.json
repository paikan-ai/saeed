{
  "ConnectionStrings": {
    // رشته‌اتصال SQL Server — در صورت نیاز تغییر دهید
    // برای SQL Server لوکال با Windows Authentication:
    "DefaultConnection": "Server=.;Database=PhonebookDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
    // نمونه برای SQL Authentication:
    // "DefaultConnection": "Server=localhost,1433;Database=PhonebookDb;User Id=sa;Password=YourStrongPassword;TrustServerCertificate=True;"
  },
  "Jwt": {
    // کلید امضای توکن — در محیط Production حتماً تغییر دهید (حداقل ۳۲ کاراکتر)
    "Key": "Phonebook-Very-Long-Secret-Key-Change-Me-2026!@#$",
    "Issuer": "Phonebook.Api",
    "Audience": "Phonebook.Clients",
    // اعتبار توکن به ساعت
    "ExpirationHours": 8
  },
  // آدرس سرویس‌دهی API — فرانت‌اند (src/lib/api.ts) با BASE_URL به همین آدرس وصل می‌شود
  "Urls": "http://localhost:5000",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
